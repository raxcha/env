[Unit]
Description=prsnlspc API
After=network.target
StartLimitIntervalSec=0

[Service]
User=prsnlspc
Group=prsnlspc
StateDirectory=prsnlspc
StateDirectoryMode=0700
WorkingDirectory=/var/lib/prsnlspc
EnvironmentFile=/etc/prsnlspc/api.env
ExecStart=/usr/local/bin/prsnlspc-api -addr 127.0.0.1:8081 -root /var/lib/prsnlspc
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
