[Unit]
Description=prsnlspc API
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
User=prsnlspc
Group=prsnlspc
StateDirectory=prsnlspc
StateDirectoryMode=0700
CacheDirectory=prsnlspc
CacheDirectoryMode=0700
WorkingDirectory=/var/lib/prsnlspc
EnvironmentFile=/etc/prsnlspc/api.env
# Falha na atualização mantém o binário anterior disponível.
ExecStartPre=-/usr/bin/timeout --kill-after=10s 300s /usr/local/libexec/prsnlspc-update
TimeoutStartSec=330
ExecStart=/var/cache/prsnlspc/prsnlspc-api -addr 127.0.0.1:8081 -root /var/lib/prsnlspc
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
