[Unit]
Description=prsnlspc API
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
User=nausea
CacheDirectory=prsnlspc
CacheDirectoryMode=0700
WorkingDirectory=/home/nausea/prsnlspc
EnvironmentFile=/etc/prsnlspc/api.env
# Falha na atualização mantém o binário anterior disponível.
ExecStartPre=-/usr/bin/timeout --kill-after=10s 300s /usr/local/libexec/prsnlspc-update
TimeoutStartSec=330
ExecStart=/var/cache/prsnlspc/prsnlspc-api -addr 127.0.0.1:8081 -root /home/nausea/prsnlspc
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/nausea/prsnlspc
PrivateTmp=true

[Install]
WantedBy=multi-user.target
